{
  "functions": { "api/access.ts": { "maxDuration": 300 },"api/mercadopago.ts":{"maxDuration":300} },
  "rewrites": [
    { "source": "/api/mercadopago/webhook", "destination": "/api/mercadopago" },
    { "source": "/api/billing/:action", "destination": "/api/mercadopago?action=:action" },
    { "source": "/api/account/trial", "destination": "/api/access?action=trial" },
    { "source": "/api/account/:action", "destination": "/api/account?action=:action" },
    { "source": "/glm/v1/:path*", "destination": "/api/access?action=proxy&path=/glm/v1/:path*" },
    { "source": "/glm/:path*", "destination": "https://66cloud.vercel.app/glm/:path*" },
    { "source": "/v1/:path*", "destination": "/api/access?action=proxy&path=/v1/:path*" },
    { "source": "/api/codex/:path*", "destination": "/api/access?action=proxy&path=/api/codex/:path*" },
    { "source": "/api/health", "destination": "https://66cloud.vercel.app/api/health" },
    { "source": "/api/admin/:path*", "destination": "https://66cloud.vercel.app/api/admin/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
