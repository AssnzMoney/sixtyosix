{
  "functions": {
    "api/access.ts": {
      "maxDuration": 300
    },
    "api/mercadopago.ts": {
      "maxDuration": 300
    },
    "api/notifications.ts": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/api/mercadopago/webhook",
      "destination": "/api/mercadopago"
    },
    {
      "source": "/api/billing/:action",
      "destination": "/api/mercadopago?action=:action"
    },
    {
      "source": "/api/account/trial",
      "destination": "/api/access?action=trial"
    },
    {
      "source": "/api/account/:action",
      "destination": "/api/account?action=:action"
    },
    {
      "source": "/glm/v1/:path*",
      "destination": "/api/access?action=proxy&path=/glm/v1/:path*"
    },
    {
      "source": "/v1/:path*",
      "destination": "/api/access?action=proxy&path=/v1/:path*"
    },
    {
      "source": "/api/codex/:path*",
      "destination": "/api/access?action=proxy&path=/api/codex/:path*"
    },
    {
      "source": "/api/health",
      "destination": "/api/access?action=health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/notifications",
      "schedule": "0 12 * * *"
    }
  ]
}
